{
    "name": "andrewgjohnson/imagettftextblur",
    "type": "library",
    "description": "imagettftextblur is a drop-in replacement for imagettftext with added parameters to add blur, glow and shadow effects to your PHP GD images",
    "keywords": [
        "gd",
        "graphics",
        "image",
        "images"
    ],
    "homepage": "https://imagettftextblur.agjgd.org",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrew G Johnson",
            "email": "andrew@andrewgjohnson.com",
            "homepage": "https://www.andrewgjohnson.com/",
            "role": "Project Lead"
        },
        {
            "name": "Philip van Heemstra",
            "homepage": "https://github.com/vHeemstra",
            "role": "Contributor"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "ext-gd": "*",
        "andrewgjohnson/agjgd": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "files": [
            "source/imagettftextblur.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AndrewGJohnson\\Imagettftextblur\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "@php vendor/bin/phpcs",
        "lint:fix": "@php vendor/bin/phpcbf",
        "phpunit": "@php vendor/bin/phpunit",
        "test": [
            "@lint",
            "@phpunit"
        ]
    }
}
